{
	"name": "@vgerbot/async",
	"version": "0.0.1",
	"private": false,
	"description": "A TypeScript-first async utility library focused on cancellable async workflows, concurrency-limited collections, control-flow primitives, and task executors.",
	"keywords": [
		"async",
		"promise",
		"cancellation",
		"concurrency",
		"queue",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vgerbot-libraries/async.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/vgerbot-libraries/async/issues"
	},
	"homepage": "https://github.com/vgerbot-libraries/async#readme",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cancellable": {
			"types": "./dist/cancellable/index.d.ts",
			"import": "./dist/cancellable/index.js"
		},
		"./cancellable/*": {
			"types": "./dist/cancellable/*.d.ts",
			"import": "./dist/cancellable/*.js"
		},
		"./cancellable/internal": null,
		"./collections": {
			"types": "./dist/collections/index.d.ts",
			"import": "./dist/collections/index.js"
		},
		"./collections/*": {
			"types": "./dist/collections/*.d.ts",
			"import": "./dist/collections/*.js"
		},
		"./collections/internalCollection": null,
		"./control-flow": {
			"types": "./dist/control-flow/index.d.ts",
			"import": "./dist/control-flow/index.js"
		},
		"./control-flow/*": {
			"types": "./dist/control-flow/*.d.ts",
			"import": "./dist/control-flow/*.js"
		},
		"./executors": {
			"types": "./dist/executors/index.d.ts",
			"import": "./dist/executors/index.js"
		},
		"./executors/*": {
			"types": "./dist/executors/*.d.ts",
			"import": "./dist/executors/*.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "biome lint --fix",
		"generate:component": "turbo gen react-component",
		"check-types": "tsc --noEmit",
		"test": "vitest run --coverage --coverage.provider=istanbul",
		"build": "tsup",
		"docs:api": "typedoc"
	},
	"devDependencies": {
		"@repo/biome-config": "workspace:^",
		"@repo/typescript-config": "workspace:*",
		"@repo/vitest-config": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"tsup": "catalog:",
		"typedoc": "^0.28.19",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
